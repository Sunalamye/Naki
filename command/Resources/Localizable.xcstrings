        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        }
      }
    },
    "%@ ⚠️ 三麻無專用模型": {
      "comment": "側欄模型名：三麻用本地四麻模型，%@＝模型名",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ⚠️ no dedicated Sanma model"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ⚠️ 三麻専用モデルなし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ⚠️ 3인 마작 전용 모델 없음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ⚠️ 三麻无专用模型"
          }
        }
      }
    },
    "%@ 新增 %@": {
      "comment": "更新預覽的權限差異，%@＝欄位名（capabilities／methods／rewriteAllow），%@＝新增項目",
