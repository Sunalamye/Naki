        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "❌ %lld회 모두 거부되어 다음 대국을 중지함"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "❌ %lld 次都未被接受，停止续局"
          }
        }
      }
    },
